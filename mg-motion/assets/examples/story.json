    },
    {
      "id": "criteria",
      "durationSeconds": 7,
      "heading": "把三个判断放在一起",
      "layout": "criteria",
      "items": [
        {
          "id": "usage",
          "label": "看用量",
          "detail": "每月计划完成多少条内容"
        },
        {
          "id": "price",
