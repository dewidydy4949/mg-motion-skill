        },
        {
          "id": "capacity",
          "label": "看产能",
          "detail": "这份额度能支持多少次实际制作"
        }
      ],
      "caption": "使用相同的比较条件，避免只看积分总量。"
    },
    {
      "id": "conclusion",
      "durationSeconds": 3,
      "heading": "选择适合实际任务的那一档",
      "layout": "criteria",
      "items": [
        {
          "id": "usage",
          "label": "看用量",
          "detail": "需求明确"
        },
        {
          "id": "price",
          "label": "看单价",
          "detail": "成本可比"
        },
        {
          "id": "capacity",
          "label": "看产能",
          "detail": "额度够用"
